    <!-- VoLTE Methods -->
    <string name="methods_title">طرق تفعيل ميزة VoLTE</string>
    <string name="methods_subtitle">اختر الطريقة المتوافقة مع طراز هاتفك وإصدار أندرويد</string>

    <!-- Method 1: Lockscreen -->
    <string name="method_lockscreen_title">الطريقة الأولى: اختصار شاشة القفل (الأكثر فعالية)</string>
    <string name="method_lockscreen_desc">تغيير الاختصار الأيمن (الكاميرا) إلى إعدادات IMS لتجاوز قيود أندرويد 13 و 14 وتفعيل وضع GCF.</string>
    <string name="method_lockscreen_apply">تعيين اختصار IMS على شاشة القفل</string>
    <string name="method_lockscreen_restore">استعادة اختصار الكاميرا الافتراضي</string>
    <string name="method_lockscreen_current">الاختصار الحالي: %1$s</string>
    <string name="method_lockscreen_dialog_title">خطوات تشغيل VoLTE</string>
    <string name="method_lockscreen_dialog_step1">1. اضغط على زر تشغيل الهاتف (البور) لإغلاق الشاشة (شاشة القفل).</string>
    <string name="method_lockscreen_dialog_step2">2. أنر الشاشة؛ ستجد أيقونة إعدادات IMS في الزاوية اليمنى السفلية.</string>
    <string name="method_lockscreen_dialog_step3">3. اسحب أيقونة IMS وأدخل رمز القفل أو البصمة لفتح القفل.</string>
    <string name="method_lockscreen_dialog_step4">4. ستفتح واجهة إعدادات IMS، قم بتفعيل خيار \"GCF MODE\".</string>
    <string name="method_lockscreen_dialog_step5">5. اضغط \"OK / موافق\" في الرسالة المنبثقة؛ ستتفعل ميزة VoLTE فوراً!</string>
    <string name="method_lockscreen_dialog_step6">6. عد إلى هذا التطبيق واضغط على \"استعادة اختصار الكاميرا الافتراضي\".</string>
    <string name="dialog_got_it">فهمت الخطوات</string>

    <!-- Method 2: Side Key -->
    <string name="method_sidekey_title">الطريقة الثانية: المفتاح الجانبي (الضغط المزدوج على زر البور)</string>
    <string name="method_sidekey_desc">تعيين الضغط مرتين على زر البور لفتح إعدادات IMS مباشرة.</string>
    <string name="method_sidekey_apply">تعيين الضغط المزدوج إلى IMS</string>
    <string name="method_sidekey_open_settings">فتح إعدادات المفتاح الجانبي</string>
    <string name="method_sidekey_restore">استعادة وظيفة الكاميرا</string>

    <!-- Method 3: Assistant -->
    <string name="method_assistant_title">الطريقة الثالثة: المساعد الرقمي (الضغط المطول على زر الهوم)</string>
    <string name="method_assistant_desc">تعيين إعدادات IMS كمساعد رقمي مؤقت بحيث يفتح عند الضغط المطول على زر الشاشة الرئيسية.</string>
    <string name="method_assistant_apply">تعيين IMS كمساعد رقمي</string>
    <string name="method_assistant_trigger">محاكاة ضغط زر الهوم مطولاً</string>
    <string name="method_assistant_restore">استعادة مساعد جوجل الافتراضي</string>

    <!-- Method 4: Direct Launch -->
    <string name="method_direct_title">الطريقة الرابعة: الفتح المباشر لإعدادات IMS</string>
    <string name="method_direct_desc">تشغيل واجهة IMS مباشرة عبر أوامر شيزوكو (يعمل على أندرويد 10 إلى 12).</string>
    <string name="method_direct_launch_ims">فتح إعدادات IMS مباشرة</string>
    <string name="method_direct_launch_band">فتح واجهة اختيار الترددات (Band Selection)</string>
    <string name="method_direct_denied">تم حظر الفتح المباشر بواسطة حماية أندرويد 14. يرجى استخدام الطريقة الأولى (اختصار شاشة القفل)!</string>

    <!-- Method 5: IMS Repair -->
    <string name="method_repair_title">الطريقة الخامسة: إصلاح وإعادة تفعيل حزم IMS</string>
    <string name="method_repair_desc">إعادة تثبيت وتفعيل حزم سامسونج الأساسية الخاصة بـ VoLTE في حال كانت معطلة أو محذوفة.</string>
    <string name="method_repair_scan">فحص حالة الحزم</string>
    <string name="method_repair_all">إصلاح وتفعيل جميع الحزم بضغطة زر</string>
