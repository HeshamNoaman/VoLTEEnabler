    <!-- VoLTE Methods -->
    <string name="methods_title">VoLTE Activation Methods</string>
    <string name="methods_subtitle">Select the method that matches your device model and Android version</string>

    <!-- Method 1: Lockscreen -->
    <string name="method_lockscreen_title">Method 1: Lockscreen Shortcut (Recommended)</string>
    <string name="method_lockscreen_desc">Replaces the lockscreen Right Shortcut (Camera) with Samsung IMS Settings. Bypasses Android 13 &amp; 14 restrictions.</string>
    <string name="method_lockscreen_apply">Set IMS to Lockscreen</string>
    <string name="method_lockscreen_restore">Restore Camera Shortcut</string>
    <string name="method_lockscreen_current">Current Shortcut: %1$s</string>
    <string name="method_lockscreen_dialog_title">Instructions to Enable VoLTE</string>
    <string name="method_lockscreen_dialog_step1">1. Press your Power button once to lock the phone screen.</string>
    <string name="method_lockscreen_dialog_step2">2. Wake the screen. The bottom-right lock icon is now IMS Settings.</string>
    <string name="method_lockscreen_dialog_step3">3. Swipe the IMS Settings icon and unlock with your PIN / Fingerprint.</string>
    <string name="method_lockscreen_dialog_step4">4. In IMS Settings, check the box for \"GCF MODE\".</string>
    <string name="method_lockscreen_dialog_step5">5. Tap \"OK\" in the confirmation popup. VoLTE will immediately register!</string>
    <string name="method_lockscreen_dialog_step6">6. Return to this app and tap \"Restore Camera Shortcut\".</string>
    <string name="dialog_got_it">Got It</string>

    <!-- Method 2: Side Key -->
    <string name="method_sidekey_title">Method 2: Side Key / Double-Press Power</string>
    <string name="method_sidekey_desc">Configures double-pressing the power button to launch IMS Settings.</string>
    <string name="method_sidekey_apply">Assign Double-Press to IMS</string>
    <string name="method_sidekey_open_settings">Open Side Key Settings</string>
    <string name="method_sidekey_restore">Restore Double-Press to Camera</string>

    <!-- Method 3: Assistant -->
    <string name="method_assistant_title">Method 3: Assistant / Long-Press Home</string>
    <string name="method_assistant_desc">Temporarily sets digital assistant to IMS Settings so long-pressing Home opens it.</string>
    <string name="method_assistant_apply">Set IMS as Assistant</string>
    <string name="method_assistant_trigger">Trigger Home Long-Press</string>
    <string name="method_assistant_restore">Restore Google Assistant</string>

    <!-- Method 4: Direct Launch -->
    <string name="method_direct_title">Method 4: Direct Launch IMS</string>
    <string name="method_direct_desc">Launches IMS Settings activity directly via Shizuku shell. Works on Android 10-12.</string>
    <string name="method_direct_launch_ims">Launch IMS Settings</string>
    <string name="method_direct_launch_band">Launch Samsung Band Selection</string>
    <string name="method_direct_denied">Direct launch blocked by Knox/Security on Android 14. Please use Method 1 (Lockscreen Shortcut)!</string>

    <!-- Method 5: IMS Repair -->
    <string name="method_repair_title">Method 5: Reinstall &amp; Enable IMS Packages</string>
    <string name="method_repair_desc">Re-enables and reinstalls missing or debloated Samsung IMS system packages (com.sec.ims, com.samsung.advp.imssettings, etc.).</string>
